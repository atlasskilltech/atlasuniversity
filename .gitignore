node_modules
.next
out
next-env.d.ts
.env*.local
.DS_Store
*.log

# asset storage (scripts/assets): local hash cache and interrupted downloads
.assets-cache.json
*.download-[0-9]*
assets.manifest.json.tmp-*
# migrated assets are served from S3 (listed in assets.manifest.json; restore with `npm run assets:download`).
# Only fonts and brand stay in git and are served from the site itself (scripts/assets/local-only.cjs).
/public/assets/*
!/public/assets/fonts/
!/public/assets/brand/
# ATLAS Hackathon 2026 (1.4 MB): kept in git as well as listed in the manifest, so any checkout can upload
# them with `npm run assets:sync -- --only=atlas-hackathon-2026 --full` (they were added from a session
# with no S3 write access). They are still served from S3 like every other migrated asset.
!/public/assets/atlas-hackathon-2026/
# the PHP reference site — local only, never uploaded
/reference/

# News DB backups + import reports (contain data; written on the server by
# .github/workflows/news-wp-import.yml). Never upload.
/backups/
