#!/bin/sh
# Git LFS hook, copied from .git/hooks: core.hooksPath = .githooks means .git/hooks is no longer read.
command -v git-lfs >/dev/null 2>&1 || { printf >&2 "\n%s\n\n" "This repository is configured for Git LFS but 'git-lfs' was not found on your path. If you no longer wish to use Git LFS, remove this hook by deleting the 'post-checkout' file in the hooks directory (set by 'core.hookspath': .githooks)."; exit 2; }
git lfs post-checkout "$@"
