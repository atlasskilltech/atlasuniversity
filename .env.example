# ---------------------------------------------------------------------------
# Meta / Instagram Graph API — "The Action never stops!" section
#
# Copy this file to `.env.local` and fill in META_ACCESS_TOKEN.
# `.env*.local` is already in .gitignore — never commit the real token.
#
# The token is read ONLY in lib/instagram/posts.js and lib/instagram/mediaUrl.js,
# both marked `server-only`. It is never sent to the browser, never logged, and
# there is deliberately no NEXT_PUBLIC_ variant of it. Media reaches the browser
# as /api/instagram/media/<id> on this origin; that route resolves Meta's signed
# CDN URL server-side per request.
# ---------------------------------------------------------------------------

# Required. A long-lived Instagram Graph API token for the page below.
#   instagram_basic            latest post, media, counts
#   pages_read_engagement      page-linked IG account access
#   instagram_manage_comments  the comments edge
# Without the comments scope the post still renders in full; the viewer then says
# comments can be read on Instagram rather than claiming there are none.
META_ACCESS_TOKEN=

# Public identifiers — safe to keep here; these are also the in-code defaults.
INSTAGRAM_BUSINESS_ID=17841449043892932
FACEBOOK_PAGE_ID=108001881594146
INSTAGRAM_HANDLE=atlasskilltechuniversity
META_API_VERSION=v21.0

# Latest-post cache lifetime in seconds (cache_duration = 900 -> 15 minutes).
META_CACHE_DURATION=900

# Retained for parity with the reference's own config; no longer read. Media is
# always proxied through /api/instagram/media/<id>, because a signed fbcdn URL in
# the HTML expires within hours and a downloaded copy cannot survive a read-only
# serverless filesystem. HTTP caching does the caching:
#   Cache-Control: public, s-maxage=900, stale-while-revalidate=3600
META_CACHE_THUMBNAILS=true

# Optional. Only needed if a manual cache-refresh endpoint is added later;
# nothing reads it today, and it must never be exposed to the browser.
META_ADMIN_REFRESH_KEY=


# ---------------------------------------------------------------------------
# Asset storage — direct public S3, no CloudFront (docs/assets-s3.md)
# ---------------------------------------------------------------------------

# Public host the site loads every /assets/... file from, without a trailing slash:
#   https://atlas-web-cdn.s3.ap-south-1.amazonaws.com   (-> .../assets/images/campus.webp)
# Leave EMPTY to serve from the local public/ folder (the default, and the rollback).
# public/assets/fonts/ and public/assets/brand/ always stay local (scripts/assets/local-only.cjs).
# Not a secret. Next.js inlines NEXT_PUBLIC_* and rewrites /assets/... at BUILD time:
# set it where `next build` runs, and restart `next dev` after changing it.
NEXT_PUBLIC_ASSET_BASE_URL=

# Used only by the developer scripts (npm run assets:sync / assets:verify / assets:download).
# Not secrets. AWS_S3_BUCKET / AWS_S3_REGION are accepted as fallbacks for the two names below.
# AWS credentials are NEVER put in this committed file: they come from your own AWS profile
# (~/.aws, `aws sso login` / `aws configure`, selected with AWS_PROFILE), from AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY in your git-ignored .env.local, or from the CI OIDC role.
ASSETS_S3_BUCKET=
ASSETS_S3_REGION=
# Optional key prefix inside the bucket (default empty -> keys are assets/...)
ASSETS_S3_PREFIX=
# Optional: Cache-Control written on uploaded objects (default below)
# ASSETS_CACHE_CONTROL=public, max-age=604800


# ---------------------------------------------------------------------------
# ATLAS AI Search — /search and POST /api/search
# ---------------------------------------------------------------------------

# Required for AI answers. SERVER-ONLY: read in lib/search/openai.js and nowhere
# else; never sent to the browser. Do NOT give it a NEXT_PUBLIC_ prefix.
# Without it the page still loads and /api/search answers 503 "not_configured".
OPENAI_API_KEY=

# Optional. Chat Completions model; defaults to gpt-4o (the legacy value).
OPENAI_MODEL=gpt-4o

# The ATLAS CRM "Enquire Now" popup on /search. Public, not a secret: it is
# inlined into the client bundle at BUILD time, so set it where `next build`
# runs. Defaults to this id when unset; set it to `off` to disable the popup
# (search then opens directly).
NEXT_PUBLIC_ATLAS_CRM_WIDGET_ID=6aec6b7adb3e850ab12780bc

# Atlas blog feed API base. The blog DETAIL pages (/atlas-blog/[slug],
# /schools/<school>/blog/[slug]) and the Thought-Leadership LISTINGS
# (/thought-leaderships, /schools/<school>/thought-leaderships) read blogs
# LIVE from this host, so a blog added in the dashboard reflects on the site
# (listings revalidate ~1 min). Defaults to the PRODUCTION dashboard host (the
# same host blogs are added to). Override only to test against UAT, e.g.
#   https://uat-dashboard.atlasskilltech.app/api/atlas-blogs
# Public data, no token in the URL.
ATLAS_BLOGS_API_BASE=https://dashboard.atlasskilltech.app/api/atlas-blogs
