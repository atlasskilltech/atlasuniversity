# ---------------------------------------------------------------------------
# Meta / Instagram Graph API — "The Action never stops!" section
#
# Copy this file to `.env.local` and fill in META_ACCESS_TOKEN.
# `.env*.local` is already in .gitignore — never commit the real token.
#
# The token is read ONLY in lib/instagram/posts.js and lib/instagram/mediaUrl.js,
# both marked `server-only`. It is never sent to the browser, never logged, and
# there is deliberately no NEXT_PUBLIC_ variant of it. Media reaches the browser
# as /api/instagram/media/<id> on this origin; that route resolves Meta's signed
# CDN URL server-side per request.
# ---------------------------------------------------------------------------

# Required. A long-lived Instagram Graph API token for the page below.
#   instagram_basic            latest post, media, counts
#   pages_read_engagement      page-linked IG account access
#   instagram_manage_comments  the comments edge
# Without the comments scope the post still renders in full; the viewer then says
# comments can be read on Instagram rather than claiming there are none.
META_ACCESS_TOKEN=

# Public identifiers — safe to keep here; these are also the in-code defaults.
INSTAGRAM_BUSINESS_ID=17841449043892932
FACEBOOK_PAGE_ID=108001881594146
INSTAGRAM_HANDLE=atlasskilltechuniversity
META_API_VERSION=v21.0

# Latest-post cache lifetime in seconds (cache_duration = 900 -> 15 minutes).
META_CACHE_DURATION=900

# Retained for parity with the reference's own config; no longer read. Media is
# always proxied through /api/instagram/media/<id>, because a signed fbcdn URL in
# the HTML expires within hours and a downloaded copy cannot survive a read-only
# serverless filesystem. HTTP caching does the caching:
#   Cache-Control: public, s-maxage=900, stale-while-revalidate=3600
META_CACHE_THUMBNAILS=true

# Optional. Only needed if a manual cache-refresh endpoint is added later;
# nothing reads it today, and it must never be exposed to the browser.
META_ADMIN_REFRESH_KEY=
