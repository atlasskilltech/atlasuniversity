   ],
   "items": [
    {
     "kind": "lead",
     "tone": "sub",
     "mods": [
      "sub-heading",
      "mrgbtm"
     ],
     "text": "At ATLAS, you don’t just dream it — you build it, protect it, and scale it. If you're working on a product, innovation, or startup idea, our IP Enablement Flow helps you take it from sketch to pitch — and even to patent. Here’s how we support you at every step:",
     "common": false
    },
    {
     "kind": "swiper",
     "mods": [
      "swiper",
      "common-swiper",
      "mrgtp-little"
     ],
     "cards": [
      {
       "kind": "mt",
       "image": {
        "src": "/assets/images/schools/isme/pages/swiper-1-entre.png",
        "alt": ""
       },
       "title": "It All Starts with\nan Idea",
       "text": "Maybe it’s a class project, a hackathon breakthrough — we help you turn it into something real."
      },
      {
       "kind": "mt",
       "image": {
        "src": "/assets/images/schools/isme/pages/swiper-entre-2.png",
        "alt": ""
       },
       "title": "Get Feedback\nfrom Experts",
       "text": "You'll work with faculty mentors and industry pros to test your idea’s potential, uniqueness, and market fit."
      },
      {
       "kind": "mt",
       "image": {
        "src": "/assets/images/schools/isme/pages/entre-3.png",
        "alt": ""
       },
       "title": "Build a Working Prototype",
       "text": "We help you turn your idea into a Proof of Concept (PoC) — through research, prototyping, and design support."
      },
      {
       "kind": "mt",
       "image": {
        "src": "/assets/images/schools/isme/pages/swiper-4-entre.png",
        "alt": ""
       },
       "title": "Protect What\nYou’ve Built",
       "text": "Our IP Cell helps you figure out the right way, whether it’s a patent, trademark, copyright, or design."
      },
      {
       "kind": "mt",
       "image": {
        "src": "/assets/images/schools/isme/pages/swiper-5-entre.png",
        "alt": ""
       },
       "title": "We’ll Help with\nthe Filing",
       "text": "Don’t worry about the legal jargon — we’ll guide you through the paperwork and file it with the right authorities."
      },
      {
       "kind": "mt",
       "image": {
        "src": "/assets/images/schools/isme/pages/swiper-6-entre.png",
        "alt": ""
       },
       "title": "You Get\nthe Credit",
       "text": "Your IP is registered in your name, with ATLAS by your side as an official supporter of your innovation."
      },
      {
       "kind": "mt",
